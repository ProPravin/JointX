# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Flask ---
JOINTX_SECRET_KEY=change-this-to-a-long-random-string
JOINTX_DEBUG=true
JOINTX_HOST=0.0.0.0
JOINTX_PORT=5000

# --- Database ---
JOINTX_DB_PATH=data/jointx.db

# --- Session ---
JOINTX_SESSION_MINUTES=60

# --- Demo / prototype mode ---
# When true, camera and IMU pipelines use clearly-labelled simulated data
# whenever real hardware is unavailable or fails. Set to false on a fully
# wired Raspberry Pi deployment with camera + ESP32 attached.
JOINTX_DEMO_MODE=true

# --- Hardware ---
JOINTX_CAMERA_INDEX=0
# Leave blank if no ESP32 is attached (demo mode will be used instead).
JOINTX_ESP32_HOST=
JOINTX_ESP32_TIMEOUT_S=2.0

# --- ML model ---
# Path to a trained XGBoost model exported from training/train.py.
# If this file does not exist, JointX runs in UNVALIDATED PROTOTYPE MODE.
JOINTX_MODEL_PATH=ml/models/jointx_xgb_model.json

# --- Sync (optional, store-and-forward to a central server -- see central_server/) ---
JOINTX_SYNC_ENDPOINT=
JOINTX_SYNC_API_KEY=
JOINTX_DEVICE_ID=

# --- SMS/WhatsApp delivery (optional, Twilio -- see backend/services/notification_service.py) ---
# Leave blank to keep the existing device-side wa.me/sms: deep-link behaviour.
JOINTX_TWILIO_ACCOUNT_SID=
JOINTX_TWILIO_AUTH_TOKEN=
JOINTX_TWILIO_SMS_FROM=
JOINTX_TWILIO_WHATSAPP_FROM=

# --- Local database backups (see tools/backup_db.py) ---
JOINTX_BACKUP_DIR=backups
JOINTX_BACKUP_RETENTION_COUNT=30
JOINTX_BACKUP_S3_BUCKET=

# --- Logging ---
JOINTX_LOG_LEVEL=INFO
